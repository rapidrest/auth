{
    "name": "@rapidrest/auth",
    "version": "1.0.0-rc.20",
    "description": "A library for implementing a complete authentication server in RapidREST.",
    "repository": "https://github.com/rapidrest/auth.git",
    "author": "RapidREST <rapidrests@gmail.com>",
    "license": "MPL-2.0",
    "contributors": [
        "Jean-Philippe Steinmetz"
    ],
    "scripts": {
        "build": "yarn lint && rimraf dist && tsc",
        "lint": "eslint ./src ./test",
        "local-audit": "yarn install && yarn npm audit -A -R \"$@\"",
        "checkup": "yarn dlx @yarnpkg/doctor \"$@\"",
        "dependency-check": "yarn dlx depcheck \"$@\"",
        "report-coverage": "cat ./coverage/lcov.info | coveralls",
        "bench": "tsx bench/index.ts",
        "bench:baseline": "yarn bench 2>&1 | tee bench/baseline.txt",
        "test": "vitest run",
        "test:prod": "npm run lint && vitest run --coverage",
        "test:watch": "vitest",
        "postversion": "git push && git push --tags"
    },
    "peerDependencies": {
        "@rapidrest/core": "1.x",
        "@rapidrest/service-core": "1.x",
        "@simplewebauthn/server": ">=13.0.0",
        "@vitejs/plugin-react": ">=4.0.0",
        "argon2": "0.x",
        "jwks-rsa": "4.x",
        "nodemon": ">=3.0.0",
        "otplib": ">=13.0.0",
        "react": "19.x",
        "react-dom": "19.x",
        "tsx": ">=4.0.0"
    },
    "peerDependenciesMeta": {
        "@simplewebauthn/server": {
            "optional": true
        },
        "@vitejs/plugin-react": {
            "optional": true
        },
        "argon2": {
            "optional": true
        },
        "jwks-rsa": {
            "optional": true
        },
        "nodemon": {
            "optional": true
        },
        "otplib": {
            "optional": true
        },
        "tsx": {
            "optional": true
        }
    },
    "bin": {
        "rapidreact": "./dist/cli/cli.js"
    },
    "dependencies": {
        "cross-spawn": "^7.0.5",
        "parse-duration": "^2.1.8"
    },
    "devDependencies": {
        "@rapidrest/core": "^1.15.0",
        "@rapidrest/service-core": "1.0.0-rc.35",
        "@simplewebauthn/server": "^13.3.2",
        "@swc/core": "^1.15.41",
        "@types/cross-spawn": "^6.0.6",
        "@types/node": "^25.9.2",
        "@types/speakeasy": "^2",
        "@typescript-eslint/eslint-plugin": "^8.61.0",
        "@typescript-eslint/parser": "^8.61.0",
        "@vitejs/plugin-react": "^6.0.3",
        "@vitest/coverage-v8": "^4.1.8",
        "argon2": "^0.44.0",
        "eslint": "^10.4.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsdoc": "^63.0.2",
        "globals": "^17.6.0",
        "ioredis": "^5.11.1",
        "ioredis-mock": "^8.13.1",
        "jwks-rsa": "^4.1.0",
        "lodash-es": "^4.18.1",
        "mongodb": "^7.5.0",
        "mongodb-memory-server": "^11.2.0",
        "nconf": "^0.13.0",
        "openapi3-ts": "^4.6.0",
        "otplib": "^13.4.1",
        "prom-client": "^15.1.3",
        "reflect-metadata": "^0.2.2",
        "rimraf": "^6.1.3",
        "speakeasy": "^2.0.0",
        "sqlite3": "^6.0.1",
        "ts-node": "^10.9.2",
        "tsx": "^4.19.3",
        "typeorm": "^0.3.20",
        "typescript": "^6.0.3",
        "unplugin-swc": "^1.5.9",
        "uuid": "^14.0.1",
        "vitest": "^4.1.8",
        "winston": "^3.19.0"
    },
    "resolutions": {
        "cross-spawn": "^7.0.5"
    },
    "packageManager": "yarn@4.5.3",
    "engines": {
        "node": ">=24.0.0"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    },
    "type": "module",
    "main": "dist/lib/index.js",
    "exports": {
        ".": {
            "import": "./dist/lib/index.js",
            "types": "./dist/types/index.d.ts"
        },
        "./mongo": {
            "import": "./dist/lib/mongo.js",
            "types": "./dist/types/mongo.d.ts"
        },
        "./sql": {
            "import": "./dist/lib/sql.js",
            "types": "./dist/types/sql.d.ts"
        }
    },
    "typings": "dist/types/index.d.ts",
    "files": [
        "dist"
    ]
}